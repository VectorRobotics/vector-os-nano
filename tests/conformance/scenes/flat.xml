<!--
  Flat ground for the locomotion bounds; the conformance conftest attaches go2.xml at
  the origin. Options are the go2's own (mujoco_go2 runs it at 1 kHz).
-->
<mujoco model="flat">
  <option timestep="0.001" cone="elliptic" impratio="100"/>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="50 50 0.1" rgba="0.8 0.8 0.8 1"/>
  </worldbody>
</mujoco>
