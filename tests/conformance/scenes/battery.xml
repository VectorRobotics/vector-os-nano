<!--
  The oracle-parity battery: floor, a table, a box and a cylinder. The conformance
  conftest attaches the Piper (vector_os_nano/embodiments/piper/model/piper.xml) at
  (0, 0, 0.2), above the table top (0.10) so top-down grasps stay inside its wrist range,
  and adds one inactive grasp weld per (link6, object).
  Physics options are the Piper's own (the world scene's options win on attach).
-->
<mujoco model="battery">
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>
  <statistic extent="1" center="0.3 0 0.2"/>
  <visual><map znear="0.01" zfar="20"/></visual>

  <worldbody>
    <light pos="0.3 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.8 0.8 0.8 1"/>
    <!-- straight down over the table: right = +x, up = +y -->
    <camera name="overhead" pos="0.3 0 0.8" xyaxes="1 0 0 0 1 0" fovy="60"/>
    <body name="table" pos="0.3 0 0.05">
      <geom type="box" size="0.12 0.25 0.05" rgba="0.6 0.4 0.2 1"/>
    </body>
    <body name="box" pos="0.3 -0.1 0.12">
      <freejoint name="box"/>
      <geom type="box" size="0.02 0.02 0.02" mass="0.05" rgba="0.9 0.1 0.1 1"/>
    </body>
    <body name="cylinder" pos="0.3 0.1 0.13">
      <freejoint name="cylinder"/>
      <geom type="cylinder" size="0.02 0.03" mass="0.05" rgba="0.1 0.2 0.9 1"/>
    </body>
  </worldbody>
</mujoco>
