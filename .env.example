# Vector OS Nano — credential template
#
# Copy this file to .env (git-ignored) and fill in the key of the provider you use.
# Keys are read ONLY from the environment / this file: never from a flag, never from
# ~/.vector/config.yaml, never from another application's login.
#
# The provider is chosen by:  vector-cli --provider <name>
#                        else  llm.provider in ~/.vector/config.yaml
#                        else  deepseek
# and each provider reads its own variable:

# deepseek (the default)
DEEPSEEK_API_KEY=

# openrouter (multi-model)
OPENROUTER_API_KEY=

# anthropic
# ANTHROPIC_API_KEY=

# openai_compat (any OpenAI-compatible endpoint; set llm.model and llm.base_url in the
# config file, and llm.api_key_env to read another variable)
# OPENAI_API_KEY=
